{
  "name": "@patrick-baber-test/suggestion",
  "description": "suggestion plugin for tiptap",
  "version": "3.10.10",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap utility"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/patrick-baber"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@patrick-baber-test/core": "workspace:^",
    "@patrick-baber-test/pm": "workspace:^"
  },
  "peerDependencies": {
    "@patrick-baber-test/core": "workspace:^",
    "@patrick-baber-test/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patrick-baber/tiptap",
    "directory": "packages/suggestion"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
