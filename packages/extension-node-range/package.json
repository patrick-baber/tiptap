{
  "name": "@patrick-baber-test/extension-node-range",
  "description": "node range extension for tiptap",
  "version": "3.10.8",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap extension"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/patrick-baber"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patrick-baber/tiptap",
    "directory": "packages/extension-node-range"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "@patrick-baber-test/core": "workspace:^",
    "@patrick-baber-test/pm": "workspace:^"
  },
  "devDependencies": {
    "@patrick-baber-test/core": "workspace:^",
    "@patrick-baber-test/pm": "workspace:^"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
