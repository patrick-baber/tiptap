{
  "name": "@patrick-baber-test/starter-kit",
  "description": "starter kit for tiptap",
  "version": "3.10.7",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap starter kit"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/patrick-baber"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@patrick-baber-test/core": "workspace:^",
    "@patrick-baber-test/extension-blockquote": "workspace:^",
    "@patrick-baber-test/extension-bold": "workspace:^",
    "@patrick-baber-test/extension-bullet-list": "workspace:^",
    "@patrick-baber-test/extension-code": "workspace:^",
    "@patrick-baber-test/extension-code-block": "workspace:^",
    "@patrick-baber-test/extension-document": "workspace:^",
    "@patrick-baber-test/extension-dropcursor": "workspace:^",
    "@patrick-baber-test/extension-gapcursor": "workspace:^",
    "@patrick-baber-test/extension-hard-break": "workspace:^",
    "@patrick-baber-test/extension-heading": "workspace:^",
    "@patrick-baber-test/extension-horizontal-rule": "workspace:^",
    "@patrick-baber-test/extension-italic": "workspace:^",
    "@patrick-baber-test/extension-link": "workspace:^",
    "@patrick-baber-test/extension-list": "workspace:^",
    "@patrick-baber-test/extension-list-item": "workspace:^",
    "@patrick-baber-test/extension-list-keymap": "workspace:^",
    "@patrick-baber-test/extension-ordered-list": "workspace:^",
    "@patrick-baber-test/extension-paragraph": "workspace:^",
    "@patrick-baber-test/extension-strike": "workspace:^",
    "@patrick-baber-test/extension-text": "workspace:^",
    "@patrick-baber-test/extension-underline": "workspace:^",
    "@patrick-baber-test/extensions": "workspace:^",
    "@patrick-baber-test/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patrick-baber/tiptap",
    "directory": "packages/starter-kit"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
